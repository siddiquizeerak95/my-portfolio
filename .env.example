# ==============================================================================
# ZS STUDIO — SECURE CONTACT TRANSMISSION CONFIGURATION
# ==============================================================================

# Target receiving address (Zeerak's email)
RECEIVING_EMAIL=siddiquizeerak95@gmail.com

# Server port
PORT=8080

# ------------------------------------------------------------------------------
# OPTION A: GMAIL SMTP (Recommended for personal Gmail)
# 1. Enable 2-Step Verification in your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g., "ZS STUDIO Portfolio").
# 4. Copy the generated 16-character password and paste below:
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=siddiquizeerak95@gmail.com
SMTP_PASS=your-16-character-app-password

# ------------------------------------------------------------------------------
# OPTION B: RESEND API (Alternative modern developer email service)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=contact@yourdomain.com

# ------------------------------------------------------------------------------
# TEST MODE (Set to true to verify form submission locally without live SMTP)
# When true, transmissions are saved to inbox/ folder and logged for decryption.
# ------------------------------------------------------------------------------
TEST_MODE=true

