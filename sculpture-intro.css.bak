/* ==========================================================================
   ZS STUDIO — 3D DOT SCULPTURE PORTRAIT INTRO
   Cinematic interactive particle sculpture welcome experience
   ========================================================================== */

.sculpture-intro-stage {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 99998; /* Sits right under the preloader (99999) and above the homepage */
  background-color: #080808;
  overflow: hidden;
  opacity: 1;
  visibility: visible;
  transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.85s ease;
  user-select: none;
  -webkit-user-select: none;
}

/* Background Atmosphere Glow */
.sculpture-ambient-glow {
  position: absolute;
  top: 50%;
  right: 25%;
  transform: translate(50%, -50%);
  width: clamp(400px, 50vw, 750px);
  height: clamp(400px, 50vw, 750px);
  background: radial-gradient(circle, rgba(229, 9, 43, 0.16) 0%, rgba(163, 0, 32, 0.06) 42%, transparent 72%);
  border-radius: 50%;
  filter: blur(60px);
  pointer-events: none;
  z-index: 1;
  transition: opacity 0.6s ease;
}

/* WebGL Canvas */
.sculpture-canvas {
  position: absolute;
  inset: 0;
  width: 100% !important;
  height: 100% !important;
  display: block;
  z-index: 2;
  cursor: grab;
}

.sculpture-canvas:active {
  cursor: grabbing;
}

/* Top Subtle Brand Bar */
.sculpture-brand-bar {
  position: absolute;
  top: clamp(20px, 3.5vh, 36px);
  left: clamp(24px, 4vw, 60px);
  right: clamp(24px, 4vw, 60px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
  pointer-events: none;
  opacity: 0;
  transform: translateY(-8px);
  transition: opacity 0.8s ease 0.6s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s;
}

.sculpture-intro-stage.active .sculpture-brand-bar {
  opacity: 1;
  transform: translateY(0);
}

.sculpture-brand-mark {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono, monospace);
  font-size: 11px;
  letter-spacing: 0.14em;
  color: #8E8E93;
  text-transform: uppercase;
}

.sculpture-dot-live {
  width: 6px;
  height: 6px;
  background-color: #E5092B;
  border-radius: 50%;
  box-shadow: 0 0 8px #E5092B;
  animation: sculptureDotPulse 2s infinite ease-in-out;
}

@keyframes sculptureDotPulse {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.3); }
}

.sculpture-hint {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-mono, monospace);
  font-size: 10.5px;
  letter-spacing: 0.12em;
  color: #66666B;
  text-transform: uppercase;
}

.sculpture-hint-icon {
  color: #E5092B;
  font-size: 11px;
}

/* Welcome Message Block — Positioned at left / top-left so it NEVER overlaps portrait */
.sculpture-welcome-block {
  position: absolute;
  top: clamp(100px, 18vh, 180px);
  left: clamp(24px, 5vw, 80px);
  max-width: clamp(340px, 36vw, 540px);
  z-index: 10;
  pointer-events: none;
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
}

.sculpture-welcome-block.visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.sculpture-tag-row {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
}

.sculpture-red-dot {
  width: 7px;
  height: 7px;
  background-color: #E5092B;
  border-radius: 50%;
  box-shadow: 0 0 10px rgba(229, 9, 43, 0.75);
}

.sculpture-tag-text {
  font-family: var(--font-mono, monospace);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: #A5A5A5;
  text-transform: uppercase;
}

.sculpture-headline {
  font-family: var(--font-sans, "Inter", sans-serif);
  font-size: clamp(2.4rem, 4.4vw, 4.5rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: #F5F5F5;
  margin: 0 0 14px 0;
}

.sculpture-headline .text-accent-red {
  color: #E5092B !important;
}

.sculpture-subline {
  font-family: var(--font-sans, "Inter", sans-serif);
  font-size: clamp(1.05rem, 1.4vw, 1.35rem);
  font-weight: 400;
  line-height: 1.4;
  color: #A5A5A5;
  letter-spacing: -0.01em;
  margin: 0;
}

/* Enter Website Button — Bottom-Right Corner */
.sculpture-enter-wrap {
  position: absolute;
  bottom: clamp(28px, 4vh, 48px);
  right: clamp(24px, 4vw, 64px);
  z-index: 20;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.8s ease 0.4s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s;
}

.sculpture-welcome-block.visible ~ .sculpture-enter-wrap,
.sculpture-intro-stage.ready .sculpture-enter-wrap {
  opacity: 1;
  transform: translateY(0);
}

.btn-sculpture-enter {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background-color: #0E0E10;
  color: #F5F5F5;
  border: 1px solid rgba(229, 9, 43, 0.55);
  border-radius: 9999px;
  padding: 14px 34px;
  font-family: var(--font-sans, "Inter", sans-serif);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  outline: none;
  box-shadow: 
    0 8px 24px rgba(0, 0, 0, 0.6),
    0 0 20px rgba(229, 9, 43, 0.22);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.btn-sculpture-enter:hover {
  background-color: #E5092B;
  border-color: #FF1A38;
  color: #FFFFFF;
  transform: translateY(-2px);
  box-shadow: 
    0 12px 32px rgba(229, 9, 43, 0.55),
    0 0 30px rgba(229, 9, 43, 0.4);
}

.btn-sculpture-enter:hover .enter-btn-arrow {
  transform: translateX(4px);
}

.btn-sculpture-enter:active {
  transform: translateY(0);
}

.enter-btn-arrow {
  font-size: 16px;
  line-height: 1;
  color: #E5092B;
  transition: transform 0.25s ease, color 0.25s ease;
}

.btn-sculpture-enter:hover .enter-btn-arrow {
  color: #FFFFFF;
}

.enter-btn-kbd {
  font-family: var(--font-mono, monospace);
  font-size: 11px;
  color: #77777D;
  margin-left: 2px;
  transition: color 0.25s ease;
}

.btn-sculpture-enter:hover .enter-btn-kbd {
  color: rgba(255, 255, 255, 0.7);
}

/* WebGL Fallback Container */
.sculpture-fallback {
  position: absolute;
  top: 50%;
  right: 15%;
  transform: translateY(-50%);
  width: clamp(280px, 32vw, 440px);
  height: auto;
  z-index: 2;
  display: none;
}

.sculpture-fallback img {
  width: 100%;
  height: auto;
  border-radius: 18px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 40px rgba(229, 9, 43, 0.2);
}

.no-webgl .sculpture-fallback {
  display: block;
}

.no-webgl .sculpture-canvas {
  display: none;
}

/* Dismissed State (Smooth exit into homepage) */
.sculpture-intro-stage.intro-dismissed {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.sculpture-intro-stage.intro-dismissed .sculpture-welcome-block {
  opacity: 0;
  transform: translateY(-16px);
  transition: opacity 0.4s ease, transform 0.4s ease;
}

.sculpture-intro-stage.intro-dismissed .sculpture-enter-wrap {
  opacity: 0;
  transform: translateY(16px);
  transition: opacity 0.3s ease, transform 0.3s ease;
}

/* ==========================================================================
   RESPONSIVE DESIGN (TABLET & MOBILE)
   ========================================================================== */
@media (max-width: 1024px) {
  .sculpture-welcome-block {
    top: clamp(80px, 12vh, 120px);
    left: clamp(20px, 4vw, 40px);
    max-width: 440px;
  }
  .sculpture-headline {
    font-size: clamp(2.2rem, 5.5vw, 3.4rem);
  }
}

@media (max-width: 768px) {
  .sculpture-brand-bar {
    top: 18px;
    left: 20px;
    right: 20px;
  }

  .sculpture-hint {
    display: none; /* Hide cursor hint on mobile */
  }

  .sculpture-welcome-block {
    top: 65px;
    left: 20px;
    right: 20px;
    max-width: 100%;
    text-align: left;
  }

  .sculpture-headline {
    font-size: clamp(1.85rem, 7.5vw, 2.4rem);
    margin-bottom: 8px;
  }

  .sculpture-subline {
    font-size: 14px;
  }

  .sculpture-enter-wrap {
    bottom: 24px;
    right: 20px;
    left: 20px;
  }

  .btn-sculpture-enter {
    width: 100%;
    justify-content: center;
    padding: 13px 24px;
    font-size: 13px;
  }

  .enter-btn-kbd {
    display: none;
  }

  .sculpture-ambient-glow {
    right: 50%;
    transform: translate(50%, -50%);
    width: 320px;
    height: 320px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sculpture-intro-stage {
    display: none !important;
  }
}

