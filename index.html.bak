<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- Primary Meta Tags -->
  <title>ZEERAK — Zeerak Siddiqui | Creative Developer</title>
  <meta name="title" content="ZEERAK — Zeerak Siddiqui | Creative Developer">
  <meta name="description"
    content="The personal portfolio of Zeerak Siddiqui. Creative developer building clean, modern digital experiences with thoughtful design and code.">
  <meta name="author" content="Zeerak Siddiqui">
  <meta name="theme-color" content="#080808">

  <!-- Open Graph / Social Meta -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="ZEERAK — Zeerak Siddiqui">
  <meta property="og:description"
    content="Creative developer portfolio of Zeerak Siddiqui. Clean, modern digital experiences with thoughtful design and code.">
  <meta property="og:image" content="./Profile%20Pic.jpg">

  <!-- Favicon / Brand Identity -->
  <link rel="icon" type="image/svg+xml" href="./zs-monogram.svg">
  <link rel="icon" type="image/png" href="./New%20fav%20icon.png">
  <link rel="shortcut icon" type="image/svg+xml" href="./zs-monogram.svg">
  <link rel="apple-touch-icon" href="./New%20fav%20icon.png">

  <!-- Theme Init Script (Zero Flash) -->
  <script>
    (function () {
      const savedTheme = localStorage.getItem('zs_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>

  <!-- Google Fonts Preconnect & Curated Modern Typography (Luxury Editorial Serif & Swiss Minimalism) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Master Stylesheet -->
  <link rel="stylesheet" href="style.css">
</head>

<body data-page="home">
  <!-- =========================================================================
       CINEMATIC WEBSITE LOADING SCREEN (ZEERAK BRAND ARCHITECTURE)
       ========================================================================= -->
  <aside id="site-preloader" class="site-preloader" aria-label="Loading ZEERAK Portfolio" aria-live="polite">
    <!-- Orbital Particle Canvas Layer -->
    <canvas id="preloader-particle-canvas" class="preloader-particle-canvas" aria-hidden="true"></canvas>

    <!-- Foreground Brand & Progress Layer -->
    <div class="preloader-content" id="preloader-content">
      <div class="preloader-brand">
        <div class="preloader-logo-wrap" id="preloader-logo-wrap">
          <img src="./New%20fav%20icon.png" alt="ZS Logo" class="preloader-logo" width="64" height="64" loading="eager">
          <div class="preloader-logo-glow" aria-hidden="true"></div>
        </div>
        <div class="preloader-text-group">
          <h1 class="preloader-wordmark" id="preloader-wordmark" aria-label="ZEERAK">
            <span class="preloader-char" style="--char-index: 0">Z</span>
            <span class="preloader-char" style="--char-index: 1">E</span>
            <span class="preloader-char" style="--char-index: 2">E</span>
            <span class="preloader-char" style="--char-index: 3">R</span>
            <span class="preloader-char" style="--char-index: 4">A</span>
            <span class="preloader-char" style="--char-index: 5">K</span>
          </h1>
          <span class="preloader-experience-tag" id="preloader-experience-tag">LOADING EXPERIENCE</span>
        </div>
      </div>

      <div class="preloader-gauge" id="preloader-gauge">
        <div class="preloader-progress-track">
          <div class="preloader-progress-bar" id="preloader-progress-bar" style="width: 0%;"></div>
        </div>
        <div class="preloader-telemetry">
          <span class="preloader-status" id="preloader-status">INITIALIZING SYSTEM</span>
          <span class="preloader-counter" id="preloader-counter">0%</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- Skip Navigation for Accessibility -->
  <a href="#main-content" class="skip-link">Skip to Primary Content [Tab]</a>

  <!-- Custom Precision Monochrome Cursor (Desktop Only) -->
  <canvas id="particle-cursor-canvas" aria-hidden="true"></canvas>
  <div class="custom-cursor" id="custom-cursor" aria-hidden="true">
    <div class="cursor-dot" id="cursor-dot"></div>
    <div class="cursor-ring" id="cursor-ring"></div>
  </div>

  <!-- SITE HEADER (REFERENCE SPECIFICATION) -->
  <header class="site-header" id="site-header">
    <div class="header-container">
      <nav class="header-nav" aria-label="Main Navigation">
        <!-- Far Left: ZS Logo + ZS STUDIO Wordmark -->
        <a href="index.html" class="header-brand" aria-label="ZS STUDIO Homepage">
          <img src="./New%20fav%20icon.png" alt="ZS logo" class="header-brand-logo" width="50" height="50" loading="eager">
          <span class="header-brand-divider" aria-hidden="true"></span>
          <span class="header-brand-name">ZS STUDIO</span>
        </a>

        <!-- Center / Main: Horizontal Navigation Links -->
        <ul class="nav-links" id="nav-links">
          <li><a href="index.html" class="nav-item active" aria-current="page">Home</a></li>
          <li><a href="about.html" class="nav-item">About</a></li>
          <li><a href="projects.html" class="nav-item">Projects</a></li>
          <li><a href="skills.html" class="nav-item">Skills</a></li>
          <li><a href="blog.html" class="nav-item">Blog</a></li>
          <li><a href="contact.html" class="nav-item">Contact</a></li>
        </ul>

        <!-- Right Side: Theme Controls & Mobile Toggle -->
        <div class="header-controls">
          <button class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <span class="theme-indicator-dot" aria-hidden="true"></span>
            <svg class="theme-moon-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="theme-sun-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>

          <!-- Mobile Hamburger Toggle Button -->
          <button class="mobile-toggle" id="mobile-toggle" aria-expanded="false" aria-controls="mobile-drawer"
            aria-label="Toggle Navigation Menu">
            <span class="hamburger-bar bar-1"></span>
            <span class="hamburger-bar bar-2"></span>
          </button>
        </div>
      </nav>
    </div>

    <!-- Mobile Navigation Drawer Overlay -->
    <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
      <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" aria-hidden="true"></div>
      <div class="mobile-drawer-inner">
        <div class="mobile-telemetry-header">
          <div class="mobile-brand-mini">
            <span>MENU</span>
          </div>
          <button class="mobile-close" id="mobile-close" aria-label="Close Navigation Menu">[ ✕ ]</button>
        </div>

        <ul class="mobile-nav-links">
          <li><a href="index.html" class="mobile-link active" aria-current="page">Home</a></li>
          <li><a href="about.html" class="mobile-link">About</a></li>
          <li><a href="projects.html" class="mobile-link">Projects</a></li>
          <li><a href="skills.html" class="mobile-link">Skills</a></li>
          <li><a href="blog.html" class="mobile-link">Blog</a></li>
          <li><a href="contact.html" class="mobile-link">Contact</a></li>
        </ul>

        <div class="mobile-drawer-footer">
          <a href="contact.html" class="btn-drawer-cta">
            <span>CONTACT ME ↗</span>
          </a>

          <div class="drawer-contact-links">
            <a href="tel:+919580912686" class="drawer-link-btn" aria-label="Call +91 9580912686">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                </path>
              </svg>
              <span>+91 9580912686</span>
            </a>
            <a href="https://www.instagram.com/_siddiqui_._zeerak_/" target="_blank" rel="noopener noreferrer"
              class="drawer-link-btn" aria-label="Visit Zeerak on Instagram: @_siddiqui_._zeerak_">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>@_siddiqui_._zeerak_</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- SECTION 01: HERO — CINEMATIC DEVELOPER SHOWCASE -->
    <section id="hero" class="section hero-section" aria-label="Hero Introduction">
      <div class="container hero-container">
        <div class="hero-split-grid">
          <!-- Left Column: Typography & Actions -->
          <div class="hero-editorial-col reveal-item">
            <p class="hero-intro-label">CREATIVE DEVELOPER</p>

            <h1 class="hero-headline"><span class="hero-greeting">Hi, I'm</span> <span class="hero-name-glow">Zeerak Siddiqui</span></h1>

            <p class="hero-subtitle">Developer &amp; Digital Creator</p>

            <p class="hero-description">
              I build clean, modern digital experiences with thoughtful design and code.
            </p>

            <!-- Outlined Technical Tags -->
            <div class="hero-tech-tags" aria-label="Technical Focus Areas">
              <span class="hero-tech-tag">BCA STUDENT</span>
              <span class="hero-tech-tag">WEB DEVELOPMENT</span>
              <span class="hero-tech-tag">FULL-STACK FOUNDATIONS</span>
              <span class="hero-tech-tag">VANILLA WEB TECHNOLOGIES</span>
            </div>

            <div class="hero-cta-group">
              <a href="projects.html" class="hero-btn-primary" id="btn-hero-work" aria-label="View My Work">
                View My Work &rarr;
              </a>
              <a href="contact.html" class="hero-btn-secondary" id="btn-hero-contact" aria-label="Contact Me">
                Contact Me
              </a>
            </div>
          </div>

          <!-- Right Column: Profile Portrait & Circuit Board Composition -->
          <div class="hero-portrait-col reveal-item">
            <div class="hero-circuit-stage" id="hero-3d-stage">
              <!-- Soft ambient grayscale lighting around head and shoulders -->
              <div class="hero-ambient-halo" aria-hidden="true"></div>

              <!-- Thin Orbital Lines (Delicate Planetary Rings Behind Portrait) -->
              <div class="hero-orbital-system" aria-hidden="true">
                <div class="orbital-ring orbital-ring-inner">
                  <span class="orbital-satellite-node node-1"></span>
                </div>
                <div class="orbital-ring orbital-ring-outer">
                  <span class="orbital-satellite-node node-2"></span>
                </div>
                <div class="orbital-ring orbital-ring-arc"></div>
              </div>

              <!-- Circuit Board Vector Trace Network -->
              <svg class="hero-circuit-svg" viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <!-- Circuit Traces Group -->
                <g class="circuit-trace-group">
                  <!-- LEFT FLANK TRACES -->
                  <!-- L1: Upper branch with via & SMD pad -->
                  <path d="M 220 236 L 150 236 L 126 212 L 50 212" class="circuit-trace trace-primary" />
                  <path d="M 50 212 L 50 226" class="circuit-trace trace-branch" />
                  <circle cx="50" cy="212" r="3.5" class="circuit-via-ring" />
                  <circle cx="50" cy="212" r="1.5" class="circuit-via-dot" />
                  <rect x="46" y="226" width="8" height="4" rx="1" class="circuit-smd-pad" />
                  <circle cx="100" cy="212" r="2" class="circuit-node-dot" />

                  <!-- L2: Bus Track A with terminal via -->
                  <path d="M 230 265 L 160 265 L 140 285 L 85 285" class="circuit-trace trace-primary" />
                  <circle cx="120" cy="285" r="2" class="circuit-node-dot" />
                  <circle cx="85" cy="285" r="3" class="circuit-via-ring" />
                  <circle cx="85" cy="285" r="1.5" class="circuit-via-dot" />

                  <!-- L3: Bus Track B with test pad -->
                  <path d="M 235 277 L 165 277 L 145 297 L 95 297 L 95 306 L 25 306" class="circuit-trace trace-primary" />
                  <circle cx="60" cy="306" r="2" class="circuit-node-dot" />
                  <rect x="18" y="304" width="7" height="4" rx="1" class="circuit-smd-pad" />

                  <!-- L4: Lower Flank Trace with dual 45-deg offsets -->
                  <path d="M 245 308 L 190 308 L 170 328 L 110 328 L 94 344 L 38 344" class="circuit-trace trace-primary" />
                  <circle cx="140" cy="328" r="2" class="circuit-node-dot" />
                  <circle cx="38" cy="344" r="3" class="circuit-via-ring" />
                  <circle cx="38" cy="344" r="1.5" class="circuit-via-dot" />

                  <!-- L5: Bottom Connector Trace -->
                  <path d="M 260 330 L 220 330 L 195 355 L 125 355" class="circuit-trace trace-subtle" />
                  <circle cx="125" cy="355" r="2" class="circuit-node-dot" />

                  <!-- Left Data / Clock Micro-Package -->
                  <rect x="32" y="254" width="52" height="24" rx="2" class="circuit-chip-body" />
                  <line x1="84" y1="262" x2="94" y2="262" class="circuit-trace trace-pin" />
                  <line x1="84" y1="270" x2="94" y2="270" class="circuit-trace trace-pin" />
                  <text x="40" y="265" class="chip-text chip-title">IO // BUS</text>
                  <text x="40" y="274" class="chip-subtext">32.7 kHz</text>

                  <!-- RIGHT FLANK TRACES -->
                  <!-- R1: Upper branch with via & SMD pad -->
                  <path d="M 380 236 L 450 236 L 474 212 L 550 212" class="circuit-trace trace-primary" />
                  <path d="M 550 212 L 550 226" class="circuit-trace trace-branch" />
                  <circle cx="550" cy="212" r="3.5" class="circuit-via-ring" />
                  <circle cx="550" cy="212" r="1.5" class="circuit-via-dot" />
                  <rect x="546" y="226" width="8" height="4" rx="1" class="circuit-smd-pad" />
                  <circle cx="500" cy="212" r="2" class="circuit-node-dot" />

                  <!-- R2: Bus Track A running to ZS Micro-IC Pin 1 -->
                  <path d="M 370 265 L 440 265 L 460 285 L 515 285" class="circuit-trace trace-primary" />
                  <circle cx="480" cy="285" r="2" class="circuit-node-dot" />

                  <!-- R3: Bus Track B running to ZS Micro-IC Pin 2 -->
                  <path d="M 365 277 L 435 277 L 455 297 L 515 297" class="circuit-trace trace-primary" />

                  <!-- R4: Lower Flank running to ZS Micro-IC Pin 3 & Exit via -->
                  <path d="M 355 308 L 410 308 L 430 328 L 515 328" class="circuit-trace trace-primary" />
                  <path d="M 575 328 L 585 338" class="circuit-trace trace-branch" />
                  <circle cx="585" cy="338" r="3" class="circuit-via-ring" />
                  <circle cx="585" cy="338" r="1.5" class="circuit-via-dot" />

                  <!-- R5: Bottom Connector Trace -->
                  <path d="M 340 330 L 380 330 L 405 355 L 475 355" class="circuit-trace trace-subtle" />
                  <circle cx="475" cy="355" r="2" class="circuit-node-dot" />

                  <!-- Right ZS Micro-IC Package (Geometric ZS Monogram Integration) -->
                  <rect x="515" y="278" width="60" height="60" rx="3" class="circuit-chip-body" />
                  <!-- Chip pins on left -->
                  <line x1="507" y1="285" x2="515" y2="285" class="circuit-trace trace-pin" />
                  <line x1="507" y1="297" x2="515" y2="297" class="circuit-trace trace-pin" />
                  <line x1="507" y1="328" x2="515" y2="328" class="circuit-trace trace-pin" />
                  <!-- Chip pins on right -->
                  <line x1="575" y1="297" x2="583" y2="297" class="circuit-trace trace-pin" />
                  <line x1="575" y1="328" x2="583" y2="328" class="circuit-trace trace-pin" />
                  <!-- Authentic ZS Geometric Monogram inside chip -->
                  <image href="./New%20fav%20icon.png" x="522" y="284" width="24" height="24" class="circuit-zs-icon" />
                  <text x="556" y="296" class="chip-text chip-brand">ZS</text>
                  <text x="556" y="306" class="chip-subtext">CORE</text>
                  <text x="545" y="326" text-anchor="middle" class="chip-text chip-mono">// 01 DEV</text>
                </g>
              </svg>

              <!-- Profile Photograph Frame (Foreground) -->
              <div class="hero-portrait-frame">
                <img src="./Profile%20Pic.jpg" alt="Zeerak Siddiqui" class="hero-portrait-img" width="340" height="340" loading="eager">
              </div>

              <!-- Floating Information Card (Orbital Telemetry Dossier) -->
              <div class="hero-info-card" aria-label="Developer Information Dossier">
                <div class="hero-info-card-header">
                  <span class="hero-info-status-dot" aria-hidden="true"></span>
                  <span class="hero-info-header-tag">ACTIVE EXPERIENCE // 2026</span>
                </div>
                <div class="hero-info-card-rows">
                  <div class="hero-info-row">
                    <span class="hero-info-label">ROLE</span>
                    <span class="hero-info-val">Creative Developer</span>
                  </div>
                  <div class="hero-info-row">
                    <span class="hero-info-label">FOCUS</span>
                    <span class="hero-info-val">Web Development</span>
                  </div>
                  <div class="hero-info-row">
                    <span class="hero-info-label">STACK</span>
                    <span class="hero-info-val">HTML5 &bull; CSS3 &bull; Vanilla JS</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         01. ABOUT SECTION — 3D FLOATING CARDS + ANIMATED ELEMENTS
         ========================================================================= -->
    <section id="home-about" class="section home-about-section" aria-label="About Zeerak Siddiqui">
      <div class="container">
        <div class="home-about-3d-grid">
          <!-- Left Column: Editorial Story & Metrics -->
          <div class="home-about-story-col reveal-item">
            <span class="section-label-minimal">ABOUT ME</span>
            <h2 class="home-about-editorial-headline">
              A story of curiosity, code and creativity.
            </h2>
            <p class="home-about-prose">
              I'm <strong>Zeerak Siddiqui</strong>, a BCA student and a passionate developer who loves building clean, modern digital experiences. I enjoy turning ideas into reality through code and design, always learning and exploring new technologies.
            </p>
            <div class="home-about-cta-wrap">
              <a href="about.html" class="btn-pill-3d" id="btn-about-more" aria-label="More About Zeerak Siddiqui">
                <span>More About Me &rarr;</span>
              </a>
            </div>

            <!-- Metrics Row (From Reference: 2+ Years Learning, 10+ Projects, 100% Dedication) -->
            <div class="home-about-metrics-row">
              <div class="metric-block">
                <div class="metric-number">2+</div>
                <div class="metric-label">Years Learning</div>
              </div>
              <div class="metric-block">
                <div class="metric-number">10+</div>
                <div class="metric-label">Projects</div>
              </div>
              <div class="metric-block">
                <div class="metric-number">100%</div>
                <div class="metric-label">Dedication</div>
              </div>
            </div>
          </div>

          <!-- Right Column: 3D Floating Portrait Card & Badges -->
          <div class="home-about-visual-col reveal-item">
            <div class="about-3d-portrait-stage" data-tilt>
              <!-- Ambient Spotlight Halo -->
              <div class="about-spotlight-halo" aria-hidden="true"></div>

              <!-- Thin Orbital Ring System Behind Portrait -->
              <div class="about-orbital-ring" aria-hidden="true"></div>

              <!-- Floating Chrome Specular Sphere -->
              <div class="about-floating-sphere" aria-hidden="true"></div>

              <!-- Portrait Frame -->
              <div class="about-portrait-card">
                <img src="./Profile%20Pic.jpg" alt="Zeerak Siddiqui portrait" class="about-portrait-img" width="380" height="420" loading="eager">
                <div class="about-portrait-glass-sheen" aria-hidden="true"></div>
              </div>

              <!-- 3 Floating Glass Pill Tags Stacked on the Right Edge -->
              <div class="about-floating-pills">
                <div class="floating-pill-badge pill-dev" style="--float-delay: 0s;">
                  <span>Developer</span>
                </div>
                <div class="floating-pill-badge pill-des" style="--float-delay: 1.2s;">
                  <span>Designer</span>
                </div>
                <div class="floating-pill-badge pill-learn" style="--float-delay: 2.4s;">
                  <span>Learner</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================================================================
         02. SKILLS SECTION — INTERACTIVE 3D CARDS + PROGRESS ANIMATIONS
         ========================================================================= -->
    <section id="preview-skills" class="section skills-section" aria-label="Skills Overview">
      <div class="container">
        <!-- Section Header -->
        <div class="skills-editorial-header reveal-item">
          <div class="skills-header-left">
            <span class="section-label-minimal">MY SKILLS</span>
            <h2 class="section-editorial-headline">Tools I Work With</h2>
          </div>
          <div class="skills-header-right">
            <p class="skills-editorial-lead">
              Technologies and tools I use to build modern digital experiences.
            </p>
          </div>
        </div>

        <!-- Category Filter Pill Bar -->
        <div class="skills-filter-nav reveal-item" role="tablist" aria-label="Skill Categories">
          <button class="skills-filter-pill active" data-category="all" role="tab" aria-selected="true">All</button>
          <button class="skills-filter-pill" data-category="frontend" role="tab" aria-selected="false">Frontend</button>
          <button class="skills-filter-pill" data-category="backend" role="tab" aria-selected="false">Backend</button>
          <button class="skills-filter-pill" data-category="tools" role="tab" aria-selected="false">Tools</button>
          <button class="skills-filter-pill" data-category="other" role="tab" aria-selected="false">Other</button>
        </div>

        <!-- 3D Pedestal Stage -->
        <div class="skills-pedestal-stage-wrap reveal-item">
          <!-- Circular 3D Pedestal Platform Base -->
