<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>Blog — Zeerak Siddiqui</title>
  <meta name="title" content="Blog — Zeerak Siddiqui">
  <meta name="description" content="Editorial essays and reflections on web architecture, minimalism, and developer growth by Zeerak Siddiqui.">
  <meta name="author" content="Zeerak Siddiqui">
  <meta name="theme-color" content="#080808">

  <!-- Open Graph / Social Meta -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Blog — Zeerak Siddiqui">
  <meta property="og:description" content="Editorial essays on web architecture, minimalism, and developer growth by Zeerak Siddiqui.">
  <meta property="og:image" content="./Profile%20Pic.jpg">

  <!-- Favicon / Brand Identity -->
  <link rel="icon" type="image/svg+xml" href="./zs-monogram.svg">
  <link rel="icon" type="image/png" href="./New%20fav%20icon.png">
  <link rel="shortcut icon" type="image/svg+xml" href="./zs-monogram.svg">
  <link rel="apple-touch-icon" href="./New%20fav%20icon.png">

  <!-- Theme Init Script (Zero Flash) -->
  <script>
    (function () {
      const savedTheme = localStorage.getItem('zs_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>

  <!-- Google Fonts Preconnect & Curated Modern Typography (Luxury Editorial Serif & Swiss Minimalism) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Master Stylesheet -->
  <link rel="stylesheet" href="style.css">
</head>
<body data-page="blog">
  <!-- Skip Navigation for Accessibility -->
  <a href="#main-content" class="skip-link">Skip to Primary Content [Tab]</a>

  <!-- Custom Precision Monochrome Cursor (Desktop Only) -->
  <canvas id="particle-cursor-canvas" aria-hidden="true"></canvas>
  <div class="custom-cursor" id="custom-cursor" aria-hidden="true">
    <div class="cursor-dot" id="cursor-dot"></div>
    <div class="cursor-ring" id="cursor-ring"></div>
  </div>

  <!-- SITE HEADER (REFERENCE SPECIFICATION) -->
  <header class="site-header" id="site-header">
    <div class="header-container">
      <nav class="header-nav" aria-label="Main Navigation">
        <!-- Far Left: ZS Logo + ZS STUDIO Wordmark -->
        <a href="index.html" class="header-brand" aria-label="ZS STUDIO Homepage">
          <img src="./New%20fav%20icon.png" alt="ZS logo" class="header-brand-logo" width="50" height="50" loading="eager">
          <span class="header-brand-divider" aria-hidden="true"></span>
          <span class="header-brand-name">ZS STUDIO</span>
        </a>

        <!-- Center / Main: Horizontal Navigation Links -->
        <ul class="nav-links" id="nav-links">
          <li><a href="index.html" class="nav-item">Home</a></li>
          <li><a href="about.html" class="nav-item">About</a></li>
          <li><a href="projects.html" class="nav-item">Projects</a></li>
          <li><a href="skills.html" class="nav-item">Skills</a></li>
          <li><a href="blog.html" class="nav-item active" aria-current="page">Blog</a></li>
          <li><a href="contact.html" class="nav-item">Contact</a></li>
        </ul>

        <!-- Right Side: Theme Controls & Mobile Toggle -->
        <div class="header-controls">
          <button class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <span class="theme-indicator-dot" aria-hidden="true"></span>
            <svg class="theme-moon-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="theme-sun-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>

          <!-- Mobile Hamburger Toggle Button -->
          <button class="mobile-toggle" id="mobile-toggle" aria-expanded="false" aria-controls="mobile-drawer"
            aria-label="Toggle Navigation Menu">
            <span class="hamburger-bar bar-1"></span>
            <span class="hamburger-bar bar-2"></span>
          </button>
        </div>
      </nav>
    </div>

    <!-- Mobile Navigation Drawer Overlay -->
    <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
      <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" aria-hidden="true"></div>
      <div class="mobile-drawer-inner">
        <div class="mobile-telemetry-header">
          <div class="mobile-brand-mini">
            <span>MENU</span>
          </div>
          <button class="mobile-close" id="mobile-close" aria-label="Close Navigation Menu">[ ✕ ]</button>
        </div>

        <ul class="mobile-nav-links">
          <li><a href="index.html" class="mobile-link">Home</a></li>
          <li><a href="about.html" class="mobile-link">About</a></li>
          <li><a href="projects.html" class="mobile-link">Projects</a></li>
          <li><a href="skills.html" class="mobile-link">Skills</a></li>
          <li><a href="blog.html" class="mobile-link active" aria-current="page">Blog</a></li>
          <li><a href="contact.html" class="mobile-link">Contact</a></li>
        </ul>

        <div class="mobile-drawer-footer">
          <a href="contact.html" class="btn-drawer-cta">
            <span>CONTACT ME ↗</span>
          </a>

          <div class="drawer-contact-links">
            <a href="tel:+919580912686" class="drawer-link-btn" aria-label="Call +91 9580912686">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <span>+91 9580912686</span>
            </a>
            <a href="https://www.instagram.com/_siddiqui_._zeerak_/" target="_blank" rel="noopener noreferrer" class="drawer-link-btn" aria-label="Visit Zeerak on Instagram: @_siddiqui_._zeerak_">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              <span>@_siddiqui_._zeerak_</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content">
    <!-- SUBPAGE HERO BANNER -->
    <section class="page-hero-banner" aria-label="Blog Page Introduction">
      <div class="container">
        <div class="breadcrumb-nav reveal-item">
          <a href="index.html">HOME</a>
          <span class="sep">/</span>
          <span>BLOG</span>
        </div>
        <h1 class="page-title reveal-item">
          Insights &amp; Ideas.
        </h1>
        <p class="page-lead reveal-item">
          Sharing my thoughts on development, design, productivity and software architecture from an undergraduate perspective.
        </p>

        <!-- Stats Chips -->
        <div class="blog-intro-stats reveal-item" style="display: flex; gap: 20px; flex-wrap: wrap; margin-top: 24px;">
          <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 9999px; padding: 6px 16px; font-family: var(--font-mono); font-size: 11.5px; color: var(--text-secondary);">
            <strong style="color: #FFFFFF;">03</strong> ARTICLES PUBLISHED
          </div>
          <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 9999px; padding: 6px 16px; font-family: var(--font-mono); font-size: 11.5px; color: var(--text-secondary);">
            <strong style="color: #FFFFFF;">100%</strong> AUTHENTIC CONTEXT
          </div>
          <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 9999px; padding: 6px 16px; font-family: var(--font-mono); font-size: 11.5px; color: var(--text-secondary);">
            <strong style="color: #FFFFFF;">0%</strong> FRAMEWORK BLOAT
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 05 MASTER SHOWCASE: 3-COLUMN MAGAZINE GRID -->
    <section class="section blog-preview-section" id="blog-grid-section" aria-label="Published Articles Showcase">
      <div class="container">
        <!-- Category Filter Pills -->
        <div class="skills-filter-row reveal-item" style="justify-content: flex-start; margin-bottom: 40px;" role="tablist" aria-label="Blog category filters">
          <button class="skills-filter-pill active" data-blog-filter="all" role="tab" aria-selected="true">All Articles</button>
          <button class="skills-filter-pill" data-blog-filter="architecture" role="tab" aria-selected="false">Web Architecture</button>
          <button class="skills-filter-pill" data-blog-filter="journey" role="tab" aria-selected="false">Developer Journey</button>
          <button class="skills-filter-pill" data-blog-filter="design" role="tab" aria-selected="false">Design Philosophy</button>
        </div>

        <!-- 3-Column Magazine Articles Grid (Reference Section 05) -->
        <div class="blog-magazine-grid">
          <!-- Article 01 -->
          <article class="magazine-article-card reveal-item" data-category="architecture" data-tilt>
            <a href="blog-how-i-built-my-portfolio.html" class="magazine-card-link" aria-label="Read How I Built My Portfolio Website">
              <div class="magazine-thumbnail-wrap">
                <img src="assets/blog-architecture.svg" alt="How I Built My Portfolio Website Architecture" class="magazine-thumb-img" width="400" height="260" loading="eager">
                <span class="magazine-date-pill">OCT 2026</span>
              </div>
              <div class="magazine-content-wrap">
                <h2 class="magazine-title">How I Built My Portfolio Website</h2>
                <p class="magazine-excerpt">
                  A complete breakdown of my portfolio, design process and key takeaways. Why I chose vanilla HTML5, CSS3 clamp math, and zero framework overhead.
                </p>
                <div class="magazine-card-footer">
                  <span class="magazine-tag-pill">Web Development</span>
                  <span class="magazine-read-arrow" aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          </article>

          <!-- Article 02 -->
          <article class="magazine-article-card reveal-item" data-category="journey" data-tilt>
            <a href="blog-my-journey-as-a-developer.html" class="magazine-card-link" aria-label="Read My Learning Journey in BCA">
              <div class="magazine-thumbnail-wrap">
                <img src="assets/blog-forest.svg" alt="My Learning Journey in BCA Path" class="magazine-thumb-img" width="400" height="260" loading="eager">
                <span class="magazine-date-pill">SEP 2026</span>
              </div>
              <div class="magazine-content-wrap">
                <h2 class="magazine-title">My Learning Journey in BCA</h2>
                <p class="magazine-excerpt">
                  Experiences, challenges and lessons from my academic journey. How low-level systems programming in C anchored my engineering discipline.
                </p>
                <div class="magazine-card-footer">
                  <span class="magazine-tag-pill">Career</span>
                  <span class="magazine-read-arrow" aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          </article>

          <!-- Article 03 -->
          <article class="magazine-article-card reveal-item" data-category="design" data-tilt>
            <a href="blog-why-i-prefer-minimalist-web-design.html" class="magazine-card-link" aria-label="Read Top Tools for Developers in 2026 / Why I Prefer Minimalist Web Design">
              <div class="magazine-thumbnail-wrap">
                <img src="assets/blog-peaks.svg" alt="Top Tools and Minimalist Web Design" class="magazine-thumb-img" width="400" height="260" loading="eager">
                <span class="magazine-date-pill">AUG 2026</span>
              </div>
              <div class="magazine-content-wrap">
                <h2 class="magazine-title">Top Tools for Developers in 2026</h2>
                <p class="magazine-excerpt">
                  Essential tools for developers, productivity workflows, and why minimalist monochromatic aesthetics elevate real-world user experiences.
                </p>
                <div class="magazine-card-footer">
                  <span class="magazine-tag-pill">Tech</span>
                  <span class="magazine-read-arrow" aria-hidden="true">&rarr;</span>
                </div>
              </div>
            </a>
          </article>
        </div>
      </div>
    </section>
  </main>

