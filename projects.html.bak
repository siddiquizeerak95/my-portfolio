  <main id="main-content">
    <!-- SUBPAGE HERO BANNER -->
    <section class="page-hero-banner" aria-label="Projects Page Introduction">
      <div class="container">
        <div class="breadcrumb-nav reveal-item">
          <a href="index.html">HOME</a>
          <span class="sep">/</span>
          <span>PROJECTS</span>
        </div>
        <h1 class="page-title reveal-item">
          Selected Creations &amp; Labs.
        </h1>
        <p class="page-lead reveal-item">
          A collection of real-world projects and software laboratories engineered from first principles—combining procedural systems logic with luxury creative web experiences.
        </p>
      </div>
    </section>

    <!-- PROJECTS SECTION: 3D GLASS CARDS SHOWCASE -->
    <section class="section" aria-label="Projects Archive">
      <div class="container">
        <!-- Category Filter Pills -->
        <div class="skills-filter-row reveal-item" style="justify-content: flex-start; margin-bottom: 40px;" role="tablist" aria-label="Project categories">
          <button class="skills-filter-pill active" data-filter="all" role="tab" aria-selected="true">All Creations</button>
          <button class="skills-filter-pill" data-filter="active" role="tab" aria-selected="false">Active Experiences</button>
          <button class="skills-filter-pill" data-filter="lab" role="tab" aria-selected="false">Upcoming Labs</button>
        </div>

        <!-- 3D Showcase Grid of Master Cards -->
        <div class="projects-showcase-grid">
          <!-- Project 01: The Living Portfolio -->
          <article class="project-card-glass-body reveal-item" data-category="active" data-tilt>
            <div class="project-card-top-meta">
              <span class="project-counter-tag">01 / 04</span>
              <div class="project-live-indicator">
                <span class="pulse-dot"></span>
                <span>ACTIVE EXPERIENCE</span>
              </div>
            </div>

            <div class="project-preview-mockup">
              <img src="assets/project-portfolio-preview.svg" alt="Portfolio Website Mockup Preview" class="project-preview-img" width="560" height="315" loading="eager">
            </div>

            <h2 class="project-headline-title">Portfolio Website</h2>
            <p class="project-summary-copy">
              A modern and responsive portfolio built with vanilla technologies. Designed and engineered from first principles as a bespoke monochrome studio. Features a mathematical fluid clamp scale, pure semantic DOM structuring, real-time telemetry, and interactive 3D perspective depth with zero runtime framework bloat.
            </p>

            <div class="project-tags-capsule-row">
              <span class="capsule-tag">HTML5</span>
              <span class="capsule-tag">CSS3 Clamp</span>
              <span class="capsule-tag">JavaScript (ES6+)</span>
              <span class="capsule-tag">WebGL</span>
              <span class="capsule-tag">Zero Bloat</span>
            </div>

            <div class="project-action-links">
              <a href="index.html" class="project-cta-link">
                <span>View Project &rarr;</span>
              </a>
              <a href="about.html" class="project-secondary-link">
                <span>System Dossier ↗</span>
              </a>
            </div>
          </article>

          <!-- Project 02: Algo.Core Visualizer -->
          <article class="project-card-glass-body reveal-item" data-category="lab" data-tilt>
            <div class="project-card-top-meta">
              <span class="project-counter-tag">02 / 04</span>
              <div class="project-live-indicator">
                <span class="pulse-dot" style="background: #3b82f6; box-shadow: 0 0 8px #3b82f6;"></span>
                <span>PROTOTYPE PHASE</span>
              </div>
            </div>

            <div class="project-preview-mockup">
              <img src="assets/project-matrix-preview.svg" alt="Algo Core Matrix Preview" class="project-preview-img" width="560" height="315" loading="eager">
            </div>

            <h2 class="project-headline-title">Algo.Core Visualizer</h2>
            <p class="project-summary-copy">
              An interactive educational visualizer bridging procedural algorithms written in C with real-time web canvas rendering. Designed to illustrate sorting dynamics (QuickSort, MergeSort), pointer traversals across linked lists, and call stack memory behaviors.
            </p>

            <div class="project-tags-capsule-row">
              <span class="capsule-tag">C Programming</span>
              <span class="capsule-tag">Canvas 2D API</span>
              <span class="capsule-tag">Algorithms</span>
              <span class="capsule-tag">Data Structures</span>
            </div>

            <div class="project-action-links">
              <span class="project-cta-link" style="opacity: 0.8; cursor: default;">
                <span>Prototype In Dev &bull; 2026</span>
              </span>
            </div>
          </article>

          <!-- Project 03: Kinetic Geometry -->
          <article class="project-card-glass-body reveal-item" data-category="lab" data-tilt>
            <div class="project-card-top-meta">
              <span class="project-counter-tag">03 / 04</span>
              <div class="project-live-indicator">
                <span class="pulse-dot" style="background: #8b5cf6; box-shadow: 0 0 8px #8b5cf6;"></span>
                <span>RESEARCH STAGE</span>
              </div>
            </div>

            <div class="project-preview-mockup">
              <img src="assets/project-3d-preview.svg" alt="Kinetic Geometry 3D Shader Preview" class="project-preview-img" width="560" height="315" loading="eager">
            </div>

            <h2 class="project-headline-title">Kinetic Geometry Lab</h2>
            <p class="project-summary-copy">
              Upcoming research into procedural mathematical geometry, custom GLSL fragment shaders, and hardware-accelerated vertex displacement in the browser. Exploring how mathematical curves like Lissajous figures and Mobius strips can be rendered interactively.
            </p>

            <div class="project-tags-capsule-row">
              <span class="capsule-tag">WebGL</span>
              <span class="capsule-tag">GLSL Shaders</span>
              <span class="capsule-tag">Three.js</span>
              <span class="capsule-tag">Procedural Math</span>
            </div>

            <div class="project-action-links">
              <span class="project-cta-link" style="opacity: 0.8; cursor: default;">
                <span>Research Lab &bull; 2026</span>
              </span>
            </div>
          </article>

          <!-- Project 04: Full-Stack Systems -->
          <article class="project-card-glass-body reveal-item" data-category="lab" data-tilt>
            <div class="project-card-top-meta">
              <span class="project-counter-tag">04 / 04</span>
              <div class="project-live-indicator">
                <span class="pulse-dot" style="background: #eab308; box-shadow: 0 0 8px #eab308;"></span>
                <span>ARCHITECTURE PHASE</span>
              </div>
            </div>

            <div class="project-preview-mockup">
              <img src="assets/project-fullstack-preview.svg" alt="Full Stack Systems Preview" class="project-preview-img" width="560" height="315" loading="eager">
            </div>

            <h2 class="project-headline-title">Full-Stack Architecture</h2>
            <p class="project-summary-copy">
              Exploring decoupled client-server communications, semantic REST endpoints, robust error propagation models, and lightweight persistent databases engineered for minimal latency and strict data validation.
            </p>

            <div class="project-tags-capsule-row">
              <span class="capsule-tag">Node.js</span>
              <span class="capsule-tag">REST API</span>
              <span class="capsule-tag">Systems Logic</span>
              <span class="capsule-tag">JSON Schema</span>
            </div>

            <div class="project-action-links">
              <span class="project-cta-link" style="opacity: 0.8; cursor: default;">
                <span>Architecture Study &bull; 2026</span>
              </span>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

