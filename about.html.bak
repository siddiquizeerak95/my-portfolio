                </div>
                <div class="specs-row">
                  <span class="specs-label">DIRECT PHONE</span>
                  <span class="specs-val"><a href="tel:+919580912686" style="color: var(--text-primary); text-decoration: underline;">+91 9580912686</a></span>
                </div>
                <div class="specs-row">
                  <span class="specs-label">INSTAGRAM</span>
                  <span class="specs-val"><a href="https://www.instagram.com/_siddiqui_._zeerak_/" target="_blank" rel="noopener noreferrer" style="color: var(--text-primary); text-decoration: underline;">@_siddiqui_._zeerak_</a></span>
                </div>
                <div class="specs-row">
                  <span class="specs-label">STATUS</span>
                  <span class="specs-val">Open to Internships &amp; Collaborations</span>
                </div>
              </div>

              <div style="margin-top: 32px; border-top: 1px solid var(--border-subtle); padding-top: 24px;">
                <a href="contact.html" class="btn-pill-3d" style="width: 100%; justify-content: center; display: inline-flex;">
